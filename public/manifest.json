{
  "manifest_version": 3,
  "name": "开发工具集",
  "version": "1.3.0",
  "description": "常用开发小工具集：TAPD 评论回填、JSON 格式化、时间戳转换、文本差异对比、JSON 重复 Key 检测、录制回放",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "开发工具集",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "unlimitedStorage",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "src/options/index.html",
  "devtools_page": "src/devtools/index.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}