# 复制本文件为 .env.local 并填入真实值

# 工蜂 Private Token（git.woa.com 个人设置 -> Access Tokens 生成）
GIT_TOKEN=your_git_private_token

# TAPD 个人访问令牌（Access Token）
# （TAPD 开放平台 -> 个人中心 -> 个人访问令牌 生成）
TAPD_AUTH=your_tapd_access_token

# ===== 查询表单默认值（VITE_ 前缀会暴露给前端，作为初始值）=====

# 工蜂仓库路径（group/repo）
VITE_PROJECT_PATH=

# 分支
VITE_BRANCH=master

# 用户（作者），英文名
VITE_AUTHOR=

# TAPD 项目 ID（workspace_id）
VITE_WORKSPACE_ID=
